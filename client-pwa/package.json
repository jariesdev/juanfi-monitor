		"@sveltejs/kit": "2.68.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/lodash": "^4.17.24",
		"@types/node": "^26.1.1",
		"@types/uikit": "^3.23.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"prettier": "^3.9.6",
