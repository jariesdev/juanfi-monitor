# VendoReport Go Server – Environment Variables
# Copy this file to .env and fill in your values.

# Database driver: "sqlite" or "mysql"
DB_DRIVER=sqlite

# SQLite — path relative to the server/ directory:
DB_DSN=../app.db

# MySQL — use this format instead (requires DB_DRIVER=mysql):
# DB_DSN=user:password@tcp(127.0.0.1:3306)/vendoreport?charset=utf8mb4&parseTime=True&loc=Local

# Environment: "development" (request logging on) or "production" (logging off)
APP_ENV=development

# HTTP server port (default: 8000)
APP_PORT=8000

# Secret key used to sign and verify JWT tokens (HS256).
# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=change_me_in_production

# Comma-separated list of allowed CORS origins.
# Subdomains of *.jaries.dev are always allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8001,http://192.46.225.21:8001
